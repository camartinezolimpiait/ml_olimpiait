{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js",
          "/assets/img/svg/icons/*.svg",
          "/assets/img/pin.png",
          "/assets/img/location.svg",
          "/assets/img/svg/home/fondo-nav.svg",
          "/assets/img/svg/iconos.svg"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": [
          "/assets/**",
          "/*.(eot|svg|cur|jpg|png|webp|gif|otf|ttf|woff|woff2|ani)"
        ]
      }
    }
  ],
  "navigationUrls": [
    "/**",
    "!/**/*.*",
    "!/**/*__*",
    "!/**/*__*/**",
    "!/resumen",
    "!/ResumenCompra",
    "!/Portal/**",
    "!/ServicioAdministradorDispositivos/**"
  ],
  "dataGroups": [
    {
      "name": "data-api",
      "urls": ["**milicencia**"],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 20,
        "maxAge": "3h",
        "timeout" :"0u"
      }
    }
  ]
}
